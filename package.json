{
  "name": "ttab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:load": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run src/lib/excel.import.test.ts",
    "test:watch": "vitest src/lib/excel.import.test.ts",
    "test:ui": "vitest --ui src/lib/excel.import.test.ts",
    "test:zipbomb": "vitest run src/lib/excel.zipbomb.test.ts",
    "test:all": "vitest run src/lib/excel.import.test.ts src/lib/excel.zipbomb.test.ts",
    "test:ui:all": "vitest --ui src/lib/excel.import.test.ts src/lib/excel.zipbomb.test.ts",
    "load": "node scripts/load/run-k6.mjs all",
    "load:ping": "node scripts/load/run-k6.mjs ping",
    "load:smoke": "node scripts/load/run-k6.mjs smoke",
    "load:normal": "node scripts/load/run-k6.mjs normal",
    "load:busy": "node scripts/load/run-k6.mjs busy",
    "load:spike": "node scripts/load/run-k6.mjs spike"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vercel/node": "^33.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/ui": "^3.2.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
